# Database Configuration
DATABASE_URL="postgresql://kortex_user:kortex_password@localhost:5432/kortex_db"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"
JWT_EXPIRY="24h"
JWT_REFRESH_EXPIRY="7d"

# Environment
NODE_ENV="development"
PORT="3000"

# Frontend Configuration
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3000"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Telegram Configuration
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-here"
TELEGRAM_BOT_USERNAME="your_bot_username"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
SMTP_FROM_EMAIL="noreply@kortex.local"
SMTP_FROM_NAME="KORTEX"

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_LENGTH=6

# Points Configuration
EVENT_BASE_POINTS=10
HACKATHON_BASE_POINTS=50
EARLY_REGISTRATION_BONUS=5
PERFECT_ATTENDANCE_BONUS=10
CATEGORY_MULTIPLIER_TECH=1.1
CATEGORY_MULTIPLIER_COMPETITION=1.2

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOCKOUT_MINUTES=15

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL="info"

# API Keys (for timetable import and admin operations)
ADMIN_API_KEY="secure-admin-api-key-here"
